# Application
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=0
SERVE_STATIC=false

# PostgreSQL
POSTGRES_DB=ai_sales
POSTGRES_USER=ai_sales
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql://ai_sales:replace-with-a-random-database-password@localhost:5432/ai_sales?schema=public
# Neon production: pooled DATABASE_URL for the app and unpooled DIRECT_URL for migrations/backups.
DIRECT_URL=
COMPOSE_DATABASE_URL=postgresql://ai_sales:replace-with-a-random-database-password@postgres:5432/ai_sales?schema=public
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000

# Redis (required in production; Compose uses the internal redis hostname)
REDIS_URL=redis://localhost:6379
COMPOSE_REDIS_URL=redis://redis:6379
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_CONNECT_RETRIES=5

# Authentication (replace both with independent random values of at least 32 characters)
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-random-refresh-secret-at-least-32-characters
JWT_ISSUER=ai-sales-platform
JWT_AUDIENCE=ai-sales-platform-web
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
BCRYPT_ROUNDS=12

# Account lifecycle and transactional email (log, smtp, or resend)
APP_BASE_URL=http://localhost:5173
EMAIL_DELIVERY_MODE=log
EMAIL_FROM=no-reply@example.com
EMAIL_REQUEST_TIMEOUT_MS=10000
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=60
RECOVERY_CODE_COUNT=8

# Browser and request security
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=3600000
AI_RATE_LIMIT_MAX=20
METRICS_AUTH_TOKEN=replace-with-a-random-metrics-token-at-least-32-characters

# Optional Groq integration. Leave the key empty to guarantee Mock AI remains cost-free.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_REQUEST_TIMEOUT_MS=30000
AI_RESPONSE_MAX_BYTES=262144
AI_MAX_TOKENS=1500
# Paid AI remains disabled at 0 even if a key is accidentally present.
AI_MONTHLY_REQUEST_LIMIT=0
AI_HISTORY_RETENTION_DAYS=90

# Verified web research. Disabled unless one provider key and a positive budget are configured.
SEARCH_ENABLED=false
SEARCH_PROVIDER=TAVILY
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPER_API_KEY=
SEARCH_MONTHLY_REQUEST_LIMIT=0
SEARCH_RESULT_LIMIT=5
SEARCH_REQUEST_TIMEOUT_MS=10000
SEARCH_RESPONSE_MAX_BYTES=262144
SEARCH_CACHE_TTL_SECONDS=3600
SEARCH_MAX_RETRIES=2

# Human-approved campaign delivery. Disabled by default.
OUTBOUND_EMAIL_ENABLED=false
# disabled: no sends; test: exact OUTBOUND_TEST_RECIPIENT only; live: real approved recipients.
OUTBOUND_DELIVERY_MODE=disabled
OUTBOUND_TEST_RECIPIENT=
OUTBOUND_DAILY_LIMIT=25
OUTBOUND_FOLLOW_UP_LIMIT=2
PLATFORM_RECIPIENT_DAILY_LIMIT=3
PLATFORM_RECIPIENT_MONTHLY_LIMIT=12
PLATFORM_RECIPIENT_COOLDOWN_HOURS=24
PLATFORM_DOMAIN_DAILY_LIMIT=50
PLATFORM_DOMAIN_MONTHLY_LIMIT=500
# Required at 32+ independent characters before live delivery can be enabled.
EMAIL_WEBHOOK_SECRET=

# Optional migration-safe Master Admin bootstrap; never hard-code an address or password.
MASTER_ADMIN_EMAIL=
# Deprecated compatibility alias.
INITIAL_ADMIN_EMAIL=
TESTER_MODE_ENABLED=false
AUTOMATION_POLL_INTERVAL_MS=5000
MAINTENANCE_INTERVAL_MS=21600000

# Optional live integration smoke tests. Keep disabled unless a release engineer explicitly opts in.
RUN_LIVE_INTEGRATION_TESTS=false
LIVE_TEST_EMAIL_RECIPIENT=
# Set only for one explicitly approved transactional smoke email; never use a campaign recipient.
LIVE_TEST_EMAIL_CONFIRM=

# Frontend (use /api for the same-origin production deployment)
VITE_API_URL=/api
